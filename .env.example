# Environment Variables Example

# API Connection Strings
ConnectionStrings__DefaultConnection=Host=localhost;Database=offerhub;Username=offerhub_user;Password=offerhub_password

# Redis Configuration
Redis__Configuration=localhost:6379

# AWS Credentials (LocalStack)
AWS__Profile=default
AWS__Region=me-south-1
AWS__ServiceURL=http://localhost:4566

# JWT Configuration
Jwt__Key=your_super_secret_key_here
Jwt__Issuer=OfferHub
Jwt__Audience=OfferHubUsers
